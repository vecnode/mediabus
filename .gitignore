# ---------------------------------------------------------------------------
# Build output
# ---------------------------------------------------------------------------
bin/*
!bin/data/
!bin/data/**
!bin/libmpv-2.dll

build/
obj/
dist/

# ---------------------------------------------------------------------------
# Compiled binaries and libraries.
#
# The *.dll / *.exe rules are broad on purpose (nothing in the tree produces one
# that should be tracked), and the negations below put back the two vendored
# artefacts a clone needs to build without a source build.
# ---------------------------------------------------------------------------
*.o
*.obj
*.a
*.so
*.dylib
*.dll
*.exe
*.exp
*.lib
*.pdb
*.ilk

!bin/libmpv-2.dll
!vendor/libmpv/lib/libmpv.dll.a

# ---------------------------------------------------------------------------
# Generated at run time, per machine. The defaults are built in, so nothing here
# is a source file: the media corpus folder, the interface scale, and the ImGui
# window layout all live next to the executables.
# ---------------------------------------------------------------------------
bin/mediabus.ini
mediabus.ini
bin/mediabus-ui.ini
mediabus-ui.ini

# ---------------------------------------------------------------------------
# Logs and scratch
# ---------------------------------------------------------------------------
*.log
*.tmp
*.swp
*~
bin/verify-live/
bin/tests-tmp-*/

# ---------------------------------------------------------------------------
# OS noise
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini

# ---------------------------------------------------------------------------
# Editors. Shared build/debug configuration is tracked; local-only files are not.
# ---------------------------------------------------------------------------
.vscode/*
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.code-workspace

# ---------------------------------------------------------------------------
# Images: generated test media and screenshots are not sources. The application
# icon is, so assets/ is put back.
# ---------------------------------------------------------------------------
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.tiff
*.webp
!assets/**
!assets/icon/icon.ico

# ---------------------------------------------------------------------------
# Vendored Dear ImGui is TRACKED source, not build output: a clone must build
# with no network access, exactly like vendor/httplib.h and vendor/json.hpp.
# Produced or refreshed by tools/fetch-imgui.ps1.
# ---------------------------------------------------------------------------
!vendor/**
!vendor/imgui/**
!vendor/imgui/backends/**
!vendor/imgui/*.h
!vendor/imgui/*.cpp

# ---------------------------------------------------------------------------
# mpv build cache (tarball + extracted source + meson build dir)
# ---------------------------------------------------------------------------
.cache/

# Generated by CMake / meson
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json

# ---------------------------------------------------------------------------
# Local test media and fixtures
# ---------------------------------------------------------------------------
experiments/fixtures/
experiments/**/*.exe
tests/fixtures/

# Local media used for live playback checks (regenerate with
# experiments/fixtures/make-fixtures.ps1)
bin/data/*.mp4
bin/data/*.mkv
bin/data/*.srt
bin/data/*.png
bin/data/*.jpg

# Codec-matrix fixtures: regenerable generated media, ~2.4 MB.
experiments/fixtures/codec/

# ---------------------------------------------------------------------------
# Generated: installed from data/ by the build. The tracked source of truth is
# data/, and bin/data is a build output.
# ---------------------------------------------------------------------------
bin/data/scripts/
bin/data/controller-scripts/
