# Build output (keep data folder placeholder)
bin/*
!bin/data/
!bin/data/**

obj/

# Compiled binaries and libraries
*.o
*.obj
*.a
*.so
*.dylib
*.dll
*.exe

# Temporary and logs
*.log
*.tmp
*.swp
*~

# OS noise
.DS_Store
Thumbs.db
Desktop.ini

# VS Code: track shared build/debug config, ignore local-only files
.vscode/*
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

*.png

*.jpg
*.jpeg
*.gif
*.bmp
*.tiff

# ---------------------------------------------------------------------------
# Vendored libmpv: produced by tools/build-libmpv.ps1 against the local ffmpeg.
# Keep it tracked so a clone can run without a full mpv source build; the
# regenerating script, the pinned version and the SHA256 live in the script.
# ---------------------------------------------------------------------------
!bin/libmpv-2.dll
!lib/libmpv.dll.a
!lib/mpv/*.h

# mpv build cache (tarball + extracted source + meson build dir)
.cache/

# Generated by CMake / meson
build/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json

# Local test media and fixtures
p0/fixtures/
p0/*.exe
tests/fixtures/

# Local media used for live playback checks (regenerate with p0/make-fixtures.ps1)
bin/data/*.mp4
bin/data/*.mkv
bin/data/*.srt
bin/data/*.png
bin/data/*.jpg
p0/*.exe

# Codec-matrix fixtures: regenerable, ~2.4 MB of generated media
p0/codec-fixtures/

# Packaged release output (tools/package_release.ps1)
dist/

# Generated: installed from scripts/media-player.lua by the build
bin/data/scripts/media-player.lua
